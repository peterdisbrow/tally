# ─── Portal E2E Test Configuration ─────────────────────────────────────────
# Copy this file to portal-e2e/.env and fill in real values.
# DO NOT commit portal-e2e/.env — it's git-ignored.

# Where the portal lives. Defaults to production (api.tallyconnect.app).
# Use http://localhost:3000 to test against a local relay-server.
PORTAL_BASE_URL=https://api.tallyconnect.app

# ─── Auto-provisioning (recommended) ───────────────────────────────────────
# When ADMIN_API_KEY is set, Playwright's global-setup will create a fresh,
# dedicated test church before each suite run and delete it on teardown.
# Resulting credentials are written to portal-e2e/.env.provisioned (also
# git-ignored) and override anything you set below.
#
# This must match the relay's process.env.ADMIN_API_KEY. If you don't
# have it, leave blank and the suite falls back to the manual creds below.
ADMIN_API_KEY=

# Optional: tweak the auto-provisioned account.
# PORTAL_E2E_EMAIL_USER=e2e-test           # local-part of the address
# PORTAL_E2E_EMAIL_DOMAIN=tallyconnect.app # everything after the @
# PORTAL_E2E_TIER=connect                  # billing tier seeded on the church
# PORTAL_E2E_SKIP_PROVISION=1              # disable auto-provision for one run
# PORTAL_E2E_KEEP_PROVISIONED=1            # skip teardown (debug a failed run)

# ─── Manual fallback (used when ADMIN_API_KEY is not set) ──────────────────
# Real church-portal credentials. Tests will create / edit / delete rooms
# and devices under this account, so use a dedicated test account — NOT a
# production customer account.
PORTAL_EMAIL=
PORTAL_PASSWORD=

# ─── Admin SPA credentials (required for the admin-panel spec only) ────────
# An /admin login. Only the read paths are exercised (email catalog list).
ADMIN_EMAIL=
ADMIN_PASSWORD=
