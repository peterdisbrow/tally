# ─── Portal E2E Test Configuration ─────────────────────────────────────────
# Copy this file to portal-e2e/.env and fill in real credentials.
# DO NOT commit portal-e2e/.env — it's git-ignored.

# Where the portal lives. Defaults to production (api.tallyconnect.app).
# Use http://localhost:3000 to test against a local relay-server.
PORTAL_BASE_URL=https://api.tallyconnect.app

# Optional: marketing site URL (if any tests target it). Defaults to tallyconnect.app.
MARKETING_BASE_URL=https://tallyconnect.app

# ─── Church portal credentials (required for most tests) ───────────────────
# A real church-portal account. Tests will create/edit/delete rooms and
# devices under this church, so use a dedicated test account — NOT a
# production customer account.
PORTAL_EMAIL=
PORTAL_PASSWORD=

# ─── Admin credentials (required for admin-panel tests) ────────────────────
# An /admin login. Only the read paths are exercised (email catalog list).
ADMIN_EMAIL=
ADMIN_PASSWORD=
